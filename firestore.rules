rules_version = '2';

// Each person can read and write only their own document, users/{their uid}, and
// that document can hold nothing but a short list of saved places.
// Paste this in the Firebase console: Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['saved'])
        && request.resource.data.saved is list
        && request.resource.data.saved.size() <= 200;
    }
  }
}
